+    @property
+    def cardinality(self):
+        return math.prod(int(hi) - int(lo) + 1 for lo, hi in zip(self.lower, self.upper))
+
+    def index(self, point):
+        index = 0
+        for value, lo, hi in zip(point, self.lower, self.upper):
+            index = index * (int(hi) - int(lo) + 1) + int(value) - int(lo)
+        return index
+
+    def point_at(self, index):
+        point = []
+        for lo, hi in reversed(list(zip(self.lower, self.upper))):
+            index, offset = divmod(index, int(hi) - int(lo) + 1)
+            point.append(int(lo) + offset)
+        return tuple(reversed(point))
+
+    def sample_unseen(self, seen, rng):
+        """Select the seeded kth unseen point in legacy lexicographic order."""
+        remaining = self.cardinality - len(seen)
+        if remaining <= np.iinfo(np.int64).max:
+            index = int(rng.integers(remaining))
+        else:
+            # Rejection over random bits also handles boxes larger than int64.
+            width = remaining.bit_length()
+            index = remaining
+            while index >= remaining:
+                index = int.from_bytes(rng.bytes((width + 7) // 8), "little") & ((1 << width) - 1)
+        for occupied in sorted(self.index(point) for point in seen):
+            if occupied > index:
+                break
+            index += 1
+        return self.point_at(index)
 
 
