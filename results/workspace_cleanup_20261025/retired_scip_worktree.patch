+def grid_coordinates(model):
+    """Record choices independently of stale continuous starting values."""
+    selected = []
+    for name in ("Xchoice", "Ychoice"):
+        choices = model.find_component(name)
+        selected.append([
+            int(i) for i in choices
+            if finite(choices[i].binary_indicator_var.value) is not None
+            and choices[i].binary_indicator_var.value > 0.5
+        ] if choices is not None else [])
+    point = [axis[0] for axis in selected] if all(len(a) == 1 for a in selected) else None
+    return {
+        "grid_point": point, "selected_coordinate_indices": selected,
+        "physical_point": [finite(model.find_component(n).value) for n in ("x", "y")],
+    }
+
